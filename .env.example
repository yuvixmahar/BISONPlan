# Backend — copy to .env for local overrides (optional; defaults work for dev)

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=

# Port for uvicorn (Railway injects PORT automatically in production)
PORT=

# Aurora footprint controls
AURORA_TIMEZONE=
BISONPLAN_CONTACT_EMAIL=

# 12 AM – 6 AM CST: cache for 30 min instead of 10 (calls still allowed)
AURORA_QUIET_START_HOUR=
AURORA_QUIET_END_HOUR=
AURORA_QUIET_CACHE_TTL_SECONDS=

# Cache TTL mode outside quiet hours: peak (5m), normal (10m), quiet (60m)
REGISTRATION_MODE=
