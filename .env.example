# Backend — copy to .env for local overrides (optional; defaults work for dev)

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Port for uvicorn (Railway injects PORT automatically in production)
PORT=8000

# Aurora footprint controls
AURORA_DAILY_BUDGET=1300
AURORA_SNOOZE_START_HOUR=23
AURORA_SNOOZE_END_HOUR=7
AURORA_TIMEZONE=America/Winnipeg
BISONPLAN_CONTACT_EMAIL=singhy5@myumanitoba.ca

# Cache TTL mode: peak (5m), normal (10m), quiet (60m)
REGISTRATION_MODE=normal
